# Palma Pool Club — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: it holds a database password and an API key.
#
# Full walkthrough: site/SETUP.md

# ── Supabase ───────────────────────────────────────────────────────────────
# Supabase → Project → Connect → "Session pooler" (port 5432).
#
# IMPORTANT: the SESSION pooler, not the transaction pooler on 6543. The
# booking path takes SELECT … FOR UPDATE inside a transaction; the transaction
# pooler does not hold a session across statements, so the lock would be
# dropped mid-transaction and two guests could take the same last sunbed.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Resend ─────────────────────────────────────────────────────────────────
# resend.com → API Keys. Sending permission is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where booking requests are sent for approval. This is the only address the
# app will ever mail besides the one a guest types into the form.
OWNER_EMAIL=vlasnik@example.com

# Verified sender. Leave unset until a domain is registered and verified in
# Resend (OPEN_QUESTIONS.md #7) — until then Resend's shared sender delivers
# only to the Resend account owner's own address, which is enough to test the
# whole flow end to end.
# RESEND_FROM=Palma Pool Club <rezervacije@palmapoolclub.rs>

# ── Owner console (/admin) ─────────────────────────────────────────────────
# Password for the booking console, where the owner sees each day, enters
# bookings taken by PHONE, and adjusts a day's capacity.
#
# Entering phone bookings is not optional housekeeping: the venue has always
# taken reservations by telephone, and until they are recorded here the site's
# occupancy figure is only half the truth and it can accept guests for a day
# that is really full.
#
# Not set = /admin refuses everyone. It never falls open.
# Use something long; it is the only thing between the internet and every
# guest's name, phone and email.
OWNER_PASSWORD=

# ── Site ───────────────────────────────────────────────────────────────────
# Absolute origin, used to build the approval link in the owner's email.
# On Vercel this should be the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
